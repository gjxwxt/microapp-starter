# 复制为 .env.deploy 后填写真实发布目标（.env.deploy 已被 .gitignore 忽略）
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=root
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
DEPLOY_SSH_PORT=22

# 可选：若绑有独立域名与 HTTPS，填入基础地址用于输出访问链接；留空则自动使用服务器 IP
PUBLIC_ORIGIN=

# 可选覆盖 app.manifest.json 的配置
DEPLOY_SLUG=
DEPLOY_PUBLIC=0
DEPLOY_SPA=0
API_SERVICE=
API_PORT=
